@prefix : <http://www.semanticweb.org/leojo/ontologies/2026/6/untitled-ontology-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/leojo/ontologies/2026/6/untitled-ontology-2/> .

<http://nexa.com/ontologies/loyalty-fraud> rdf:type owl:Ontology ;
                                            rdfs:comment "Semantic schema defining entities, relationships, and data constraints for Nexa loyalty points transfers." ;
                                            rdfs:label "Nexa Loyalty Program Fraud Detection Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://nexa.com/ontologies/loyalty-fraud#appliedRate
:appliedRate rdf:type owl:ObjectProperty ;
             rdfs:domain :PointsTransfer ;
             rdfs:range :ConversionRate ;
             rdfs:label "applied rate" .


###  http://nexa.com/ontologies/loyalty-fraud#belongsToPartner
:belongsToPartner rdf:type owl:ObjectProperty ;
                  rdfs:domain :LoyaltyAccount ;
                  rdfs:range :Partner ;
                  rdfs:label "belongs to partner" .


###  http://nexa.com/ontologies/loyalty-fraud#fromDevice
:fromDevice rdf:type owl:ObjectProperty ;
            rdfs:domain :PointsTransfer ;
            rdfs:range :Device ;
            rdfs:label "from device" .


###  http://nexa.com/ontologies/loyalty-fraud#hasNexaAccount
:hasNexaAccount rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:InverseFunctionalProperty ;
                rdfs:domain :Customer ;
                rdfs:range :NexaAccount ;
                rdfs:label "has Nexa account" .


###  http://nexa.com/ontologies/loyalty-fraud#initiatedTransfer
:initiatedTransfer rdf:type owl:ObjectProperty ;
                   rdfs:domain :NexaAccount ;
                   rdfs:range :PointsTransfer ;
                   rdfs:label "initiated transfer" .


###  http://nexa.com/ontologies/loyalty-fraud#ownsLoyaltyAccount
:ownsLoyaltyAccount rdf:type owl:ObjectProperty ;
                    rdfs:domain :Customer ;
                    rdfs:range :LoyaltyAccount ;
                    rdfs:label "owns loyalty account" .


###  http://nexa.com/ontologies/loyalty-fraud#rateFor
:rateFor rdf:type owl:ObjectProperty ;
         rdfs:domain :ConversionRate ;
         rdfs:range :Partner ;
         rdfs:label "rate for partner" .


###  http://nexa.com/ontologies/loyalty-fraud#transferredTo
:transferredTo rdf:type owl:ObjectProperty ;
               rdfs:domain :PointsTransfer ;
               rdfs:range :LoyaltyAccount ;
               rdfs:label "transferred to" .


###  http://nexa.com/ontologies/loyalty-fraud#usedDevice
:usedDevice rdf:type owl:ObjectProperty ;
            rdfs:domain :Customer ;
            rdfs:range :Device ;
            rdfs:label "used device" .


###  http://nexa.com/ontologies/loyalty-fraud#viaPartner
:viaPartner rdf:type owl:ObjectProperty ;
            rdfs:domain :PointsTransfer ;
            rdfs:range :Partner ;
            rdfs:label "via partner" .


#################################################################
#    Data properties
#################################################################

###  http://nexa.com/ontologies/loyalty-fraud#account_id
:account_id rdf:type owl:DatatypeProperty ;
            rdfs:domain :NexaAccount ;
            rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#customer_id
:customer_id rdf:type owl:DatatypeProperty ;
             rdfs:domain :Customer ;
             rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#device_id
:device_id rdf:type owl:DatatypeProperty ;
           rdfs:domain :Device ;
           rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#loyalty_account_id
:loyalty_account_id rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LoyaltyAccount ;
                    rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#partner_id
:partner_id rdf:type owl:DatatypeProperty ;
            rdfs:domain :Partner ;
            rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#rate_id
:rate_id rdf:type owl:DatatypeProperty ;
         rdfs:domain :ConversionRate ;
         rdfs:range xsd:string .


###  http://nexa.com/ontologies/loyalty-fraud#transfer_id
:transfer_id rdf:type owl:DatatypeProperty ;
             rdfs:domain :PointsTransfer ;
             rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://nexa.com/ontologies/loyalty-fraud#Account
:Account rdf:type owl:Class ;
         rdfs:comment "Base ledger class for points or financial accounts." ;
         rdfs:label "Account" .


###  http://nexa.com/ontologies/loyalty-fraud#ConversionRate
:ConversionRate rdf:type owl:Class ;
                rdfs:comment "Applied multiplier for converting points to partner currencies." ;
                rdfs:label "Conversion Rate" .


###  http://nexa.com/ontologies/loyalty-fraud#Customer
:Customer rdf:type owl:Class ;
          rdfs:comment "A registered cardholder in the Nexa system." ;
          rdfs:label "Customer" .


###  http://nexa.com/ontologies/loyalty-fraud#Device
:Device rdf:type owl:Class ;
        rdfs:comment "Hardware or web client used to interact with the platform." ;
        rdfs:label "Device" .


###  http://nexa.com/ontologies/loyalty-fraud#LoyaltyAccount
:LoyaltyAccount rdf:type owl:Class ;
                rdfs:subClassOf :Account ;
                rdfs:comment "An external partner loyalty account (e.g., airline miles, hotel program)." ;
                rdfs:label "Loyalty Account" .


###  http://nexa.com/ontologies/loyalty-fraud#NexaAccount
:NexaAccount rdf:type owl:Class ;
             rdfs:subClassOf :Account ;
             rdfs:comment "A customer's primary credit card account holding points." ;
             rdfs:label "Nexa Account" .


###  http://nexa.com/ontologies/loyalty-fraud#Partner
:Partner rdf:type owl:Class ;
         rdfs:comment "External reward program vendor (Airlines, Hotels)." ;
         rdfs:label "Partner" .


###  http://nexa.com/ontologies/loyalty-fraud#PointsTransfer
:PointsTransfer rdf:type owl:Class ;
                rdfs:subClassOf :Transaction ;
                rdfs:comment "Event representing a points conversion from NexaAccount to LoyaltyAccount." ;
                rdfs:label "Points Transfer" .


###  http://nexa.com/ontologies/loyalty-fraud#Transaction
:Transaction rdf:type owl:Class ;
             rdfs:comment "Base class for points movement events." ;
             rdfs:label "Transaction" .


#################################################################
#    Individuals
#################################################################

###  http://nexa.com/ontologies/loyalty-fraud#John
:John rdf:type owl:NamedIndividual ,
               :Customer ;
      :hasNexaAccount <http://nexa.com/ontologies/loyalty-fraud#123> .


###  http://nexa.com/ontologies/loyalty-fraud#123
<http://nexa.com/ontologies/loyalty-fraud#123> rdf:type owl:NamedIndividual ,
                                                        :NexaAccount .


